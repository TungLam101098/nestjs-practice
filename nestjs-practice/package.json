{
  "name": "nestjs-practice",
  "version": "0.0.1",
  "description": "",
  "author": {
    "name": "lam.nguyen",
    "email": "lam.nguyen@asnet.com.vn"
  },
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "npx @biomejs/biome format src",
    "spell-check": "cspell \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "husky:prepare": "cd .. && husky install nestjs-practice/.husky",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/config/typeorm.migration.config.ts",
    "migration:generate": "npm run typeorm -- migration:generate src/scripts/migrations/$npm_config_name",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "docker:dev": "docker compose --env-file .env -f docker/docker-compose.database.yaml -f docker/docker-compose.dev.yaml up --build",
    "docker:prod": "docker compose --env-file .env -f docker/docker-compose.database.yaml -f docker/docker-compose.prod.yaml up --build",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@nestjs/cache-manager": "3.0.1",
    "@nestjs/common": "11.0.10",
    "@nestjs/config": "4.0.0",
    "@nestjs/core": "11.0.10",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.0.10",
    "@nestjs/swagger": "11.0.6",
    "@nestjs/typeorm": "11.0.0",
    "bcrypt": "5.1.1",
    "cache-manager": "6.4.1",
    "dayjs": "1.11.13",
    "joi": "17.13.3",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "pg": "8.13.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "typeorm": "0.3.20"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@eslint/eslintrc": "3.2.0",
    "@eslint/js": "9.18.0",
    "@faker-js/faker": "9.6.0",
    "@nestjs/cli": "11.0.0",
    "@nestjs/schematics": "11.0.0",
    "@nestjs/testing": "11.0.1",
    "@swc/cli": "0.6.0",
    "@swc/core": "1.10.7",
    "@types/bcrypt": "5.0.2",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.7",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "@types/pg": "8.11.11",
    "@types/supertest": "6.0.2",
    "cspell": "8.17.5",
    "eslint": "9.18.0",
    "eslint-plugin-import": "2.31.0",
    "globals": "15.14.0",
    "husky": "8.0.3",
    "jest": "29.7.0",
    "lint-staged": "13.2.3",
    "source-map-support": "0.5.21",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "cspell --no-summary",
      "eslint --fix",
      "npx @biomejs/biome check --write"
    ]
  }
}
